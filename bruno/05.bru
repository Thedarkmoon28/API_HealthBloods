meta {
  name: 05 Calcular
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/calculos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
{
  "productoID": "{{productoID}}",
  "tipoCaptura": "CAJAS",
  "cantidad": 3,
  "fechaDescongelacion": "2026-11-12"
}
}
